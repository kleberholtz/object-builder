{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Object Builder",
  "version": "0.5.4",
  "identifier": "com.holtz.object-builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Object Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
